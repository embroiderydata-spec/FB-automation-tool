# ==============================================================================
# PagePulse AI — Facebook Page Automation Platform
# Production Environment Variable Specification & Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
PORT=3000

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database & Authentication
# ------------------------------------------------------------------------------
# Retrieve from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. Meta Developer App & Facebook OAuth Integration (Graph API v21.0)
# ------------------------------------------------------------------------------
# Retrieve from: https://developers.facebook.com/apps/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/meta/callback

# ------------------------------------------------------------------------------
# 4. Token Encryption Key (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte key formatted as a 64-character hexadecimal string.
# Used to encrypt Facebook Page Access Tokens at rest in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_hex_character_encryption_key_here

# ------------------------------------------------------------------------------
# 5. OpenAI Provider (Phase 2.2 AI Content Engine)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_REQUESTS_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 6. AI Video & Voice Providers (Phase 2.3 Video Engine)
# ------------------------------------------------------------------------------
VIDEO_PROVIDER=replicate
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here
RUNWAY_API_KEY=your_runway_api_key_here

ELEVENLABS_API_KEY=xi-your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 7. Production Reliability, Worker & Cost Protection
# ------------------------------------------------------------------------------
AI_MAX_DAILY_BUDGET=25.00
AI_MAX_MONTHLY_BUDGET=250.00
MAX_CONCURRENT_VIDEO_JOBS=2
VIDEO_RENDER_TIMEOUT_SECONDS=600
LOG_LEVEL=info
