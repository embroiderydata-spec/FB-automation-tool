# ==============================================================================
# AI Facebook Page Automation Platform - Environment Variables
# ==============================================================================

# Supabase Public Configuration (Required for Phase 1 Authentication & Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Server-side Role Key (DO NOT expose in client code or with NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Meta Facebook Developer App Credentials & OAuth Configuration (Phase 2.1)
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/callback

# AES-256-GCM Token Encryption Key (64 hex characters = 32-byte key)
TOKEN_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# ------------------------------------------------------------------------------
# OpenAI Provider Configuration (Phase 2.2 AI Content Engine & DALL-E)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_REQUESTS_PER_MINUTE=20
AI_MAX_DAILY_BUDGET=10.00

# ------------------------------------------------------------------------------
# AI Video & Voice Providers (Phase 2.3 Video Production Engine)
# ------------------------------------------------------------------------------
VIDEO_PROVIDER=replicate
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
MAX_CONCURRENT_VIDEO_JOBS=2
DAILY_VIDEO_BUDGET=25.00
